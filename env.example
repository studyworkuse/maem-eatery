# Salin ke .env.local untuk development lokal (vercel dev).
# Untuk production, isi semua variabel ini di Vercel > Project > Settings > Environment Variables.

# ID spreadsheet (bagian di antara /d/ dan /edit pada URL Google Sheets)
SPREADSHEET_ID=1EpDsGV1Vp1sx_hRwzEXiqwoabjaL39LG2y-_r6x9I3Q

# Dari file JSON Service Account Google: field "client_email" dan "private_key"
GOOGLE_SERVICE_ACCOUNT_EMAIL=maem-eatery@your-project.iam.gserviceaccount.com
# Tempel private_key apa adanya (boleh dengan \n literal, di dalam tanda kutip ganda)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# PIN admin (4-12 karakter). Tidak lagi ada di kode frontend.
ADMIN_PIN=ganti-pin-anda

# String acak panjang untuk menandatangani sesi admin (min. 32 karakter).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
